PROJECT_NAME           = "Kartoza Screencaster"
PROJECT_NUMBER         = 1.9.0
PROJECT_BRIEF          = "Qt-based screen recorder for Linux, macOS and Windows"
# Doxygen output lives outside docs/ so MkDocs doesn't pick it up as
# orphan files. The combined Docs.yml workflow copies build/doxygen/html
# into site/api/ before publishing to GitHub Pages.
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = src/
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_COLORSTYLE        = DARK
HTML_DYNAMIC_MENUS     = YES
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
SORT_MEMBER_DOCS       = YES
WARN_IF_UNDOCUMENTED   = YES
QUIET                  = YES
